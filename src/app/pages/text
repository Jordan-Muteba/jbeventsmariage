                [alt]="'Logo de ' + boisson.libelle"
                class="max-h-24 max-w-full object-contain sm:max-h-28"
                loading="lazy">
            </div>

            <h3 class="break-words font-serif text-sm font-semibold sm:text-base lg:text-lg">
              {{ boisson.libelle }}
            </h3>

            <p class="mt-2 break-words text-xs leading-5 text-slate-600 /70">
              {{ boisson.description }}
            </p>
          </button>
        }
      </div>

      <p class="mt-5 text-center text-xs leading-5 text-white/80 sm:text-sm">
        Votre sélection sera associée à votre invitation personnelle.
      </p>

      <div class="mt-6 text-center">
        <button
          type="button"
          (click)="enregistrerBoissons()"
          [disabled]="boissonsSelectionnees.length === 0"
          class="w-full cursor-pointer rounded-full bg-amber-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-amber-700 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto sm:min-w-64  ">
          Enregistrer mon choix
        </button>
      </div>

      @if (messageBoissons) {
        <p role="status" class="mt-4 break-words text-center text-sm" aria-live="polite">
          {{ messageBoissons }}
        </p>
      }

    </div>
  </section>


  <hr class="border-slate-300 ">


  <!-- ================= LIVRE D'OR ================= -->
  <section id="livre-or" class="relative isolate overflow-hidden px-4 py-12 sm:px-6 sm:py-16 md:py-20">

    <img
      [src]="invitation.mariage.livre"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 -z-20 h-full w-full object-cover">

    <div class="absolute inset-0 -z-10 bg-[#212d20]/75"></div>

    <div class="relative mx-auto max-w-3xl text-white">

      <div class="mb-8 text-center sm:mb-10">
        <p class="text-xs uppercase tracking-[0.2em] text-amber-300 sm:tracking-[0.3em]">
          Vos mots nous touchent
        </p>

        <h2 class="mt-3 font-serif text-3xl sm:text-4xl">
          Livre d'or
        </h2>

        <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-white/80 sm:text-base">
          Laissez-nous un mot, une bénédiction ou un vœu de bonheur pour les mariés.
        </p>
      </div>

      <form
        (submit)="publierMessage($event)"
        class="rounded-2xl border border-white/15 bg-white/95 p-4 text-slate-900 shadow-xl sm:p-6 md:p-7  ">

        <label for="nomAuteur" class="mb-2 block text-sm font-medium">
          Votre nom
        </label>

        <input
          id="nomAuteur"
          type="text"
          name="nomAuteur"
          [(ngModel)]="nouveauMessage.nom"
          required
          maxlength="100"
          placeholder="Votre nom"
          class="mb-5 w-full min-w-0 rounded-xl border border-stone-300 bg-transparent px-4 py-3 text-base outline-none transition focus:border-amber-600 focus:ring-2 focus:ring-amber-600/20 ">

        <label for="texteMessage" class="mb-2 block text-sm font-medium">
          Votre message
        </label>

        <textarea
          id="texteMessage"
          name="texteMessage"
          [(ngModel)]="nouveauMessage.texte"
          required
          minlength="2"
          maxlength="1000"
          rows="4"
          placeholder="Que souhaitez-vous aux mariés ?"
          class="w-full min-w-0 resize-y rounded-xl border border-stone-300 bg-transparent px-4 py-3 text-base outline-none transition focus:border-amber-600 focus:ring-2 focus:ring-amber-600/20 "></textarea>

        <button
          type="submit"
          [disabled]="!nouveauMessage.nom.trim() || !nouveauMessage.texte.trim()"
          class="mt-5 w-full cursor-pointer rounded-full bg-amber-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-amber-800 disabled:cursor-not-allowed disabled:opacity-50  ">
          ❤️ Signer le livre d'or
        </button>

        @if (messageLivreOr) {
          <p role="status" aria-live="polite" class="mt-4 break-words text-center text-sm">
            {{ messageLivreOr }}
          </p>
        }
      </form>

      <div class="mt-8 sm:mt-10">
        <h3 class="mb-5 text-center font-serif text-xl sm:text-2xl">
          Les petits mots de nos invités
        </h3>

        @for (message of messagesLivreOr; track message.id) {
          <article class="mb-4 rounded-2xl border border-white/15 bg-white/90 p-4 text-slate-900 shadow-md sm:p-5  ">

            <div class="flex min-w-0 items-start gap-3 sm:gap-4">

              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-800 /20 ">
                ♡
              </div>

              <div class="min-w-0 flex-1">
                <h4 class="break-words font-semibold">
                  {{ message.nom }}
                </h4>

                <p class="mt-2 whitespace-pre-wrap break-words text-sm leading-6 text-slate-600 /80">
                  {{ message.texte }}
                </p>
              </div>

            </div>
          </article>
        } @empty {
          <p class="py-6 text-center text-sm text-white/80">
            Soyez le premier à laisser un mot aux mariés.
          </p>
        }
      </div>

    </div>
  </section>


  <!-- ================= LIEU ET CARTE ================= -->
  <section class="bg-slate-950 px-4 py-12 text-white sm:px-6 sm:py-20 md:py-28">

    <div class="mx-auto max-w-6xl">

      <div class="text-center">
        <p class="text-xs uppercase tracking-[0.3em] text-amber-400 sm:tracking-[0.4em]">
          Le lieu
        </p>

        <h2 class="mt-4 break-words font-serif text-3xl font-light sm:mt-5 sm:text-4xl md:text-5xl">
          Rendez-vous à
          <span class="block mt-2">{{ invitation.mariage.lieu }}</span>
        </h2>

        <p class="mx-auto mt-5 max-w-2xl break-words text-sm leading-6 text-white/70 sm:text-base">
          {{ invitation.mariage.adresse }}
        </p>
      </div>

      <!-- Carte -->
      <div class="relative mt-8 overflow-hidden rounded-2xl border border-white/10 bg-slate-900 shadow-2xl sm:mt-12 md:mt-14">

        <div class="flex min-h-[300px] items-center justify-center bg-[url('/assets/images/invitation/galerie-3.jpg')] bg-cover bg-center px-3 py-10 sm:min-h-[400px] md:min-h-[500px]">

          <div class="flex w-full max-w-md flex-col items-center">

            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-red-500 text-2xl shadow-2xl sm:h-16 sm:w-16">
              📍
            </div>

            <div class="mt-4 max-w-full rounded-xl bg-white px-4 py-4 text-center text-slate-900 shadow-xl sm:px-6">
              <p class="break-words font-semibold sm:text-lg">
                {{ invitation.mariage.lieu }}
              </p>

              <p class="mt-2 break-words text-xs leading-5 text-slate-600 sm:text-sm">
                {{ invitation.mariage.adresse }}
              </p>
            </div>

          </div>
        </div>

        <div class="flex flex-col gap-3 border-t border-white/10 p-4 sm:flex-row sm:justify-center sm:p-5">
          <button
            type="button"
            (click)="ouvrirCarte()"
            class="w-full cursor-pointer rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition hover:bg-amber-100 sm:w-auto sm:min-w-48">
            🧭 Itinéraire
          </button>
        </div>

      </div>
    </div>
  </section>


  <!-- ================= CONFIRMATION ================= -->
  <section class="relative isolate overflow-hidden px-4 py-16 sm:px-6 sm:py-24 md:py-36">

    <img
      [src]="invitation.mariage.hero"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center">

    <div class="absolute inset-0 -z-10 bg-black/70"></div>

    <div class="relative z-10 mx-auto max-w-2xl text-center text-white">

      <p class="text-xs uppercase tracking-[0.25em] text-white/70 sm:tracking-[0.4em]">
        Votre présence compte
      </p>

      <h2 class="mt-5 break-words font-serif text-3xl font-light sm:mt-6 sm:text-5xl md:text-6xl">
        Serez-vous des nôtres ?
      </h2>

      <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-white/80 sm:mt-6 sm:text-base">
        Nous serions très heureux de vous compter parmi nous.
      </p>

      <hr class="mx-auto my-6 max-w-xs border-white/30">

      <p class="mx-auto max-w-lg text-xs leading-6 text-amber-300 sm:text-sm">
        En cas d'indisponibilité, cliquez sur le bouton ci-dessous afin d'annuler votre invitation.
      </p>

      <button
        type="button"
        (click)="confirmerPresence()"
        class="mt-8 w-full cursor-pointer rounded-full bg-white px-6 py-4 text-sm font-semibold text-slate-900 shadow-2xl transition duration-300 hover:-translate-y-1 hover:bg-amber-50 sm:mt-10 sm:w-auto sm:min-w-64 sm:px-9">
        Annuler mon invitation
      </button>

    </div>
  </section>


  <!-- ================= FOOTER ================= -->
  <footer class="relative overflow-hidden bg-white px-4 py-8 sm:px-6 sm:py-12 md:py-16">

    <img
      [src]="invitation.mariage.logo"
      alt="Logo du mariage"
      class="mx-auto h-auto max-h-40 w-full max-w-[800px] object-contain sm:max-h-48 md:max-h-56">

  </footer>

</div>